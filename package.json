{
  "name": "mediabase",
  "version": "0.1.4",
  "private": true,
  "type": "module",
  "scripts": {
    "build:web": "node scripts/gen-client-roster.mjs && pnpm --filter @mediabase/web run build",
    "build:base": "node scripts/build-base.mjs",
    "notice": "node scripts/notice.mjs",
    "check:native": "node scripts/check-native-licenses.mjs",
    "build": "pnpm run build:web",
    "host": "tsx apps/cli/src/index.ts",
    "dev": "pnpm run build:web && tsx apps/cli/src/index.ts",
    "typecheck": "tsc -p tsconfig.host.json && tsc -p tsconfig.client.json && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint .",
    "doctor": "node scripts/doctor.mjs",
    "verify:base": "node scripts/verify.base.mjs",
    "package": "node scripts/package.mjs",
    "build:host": "node scripts/build-host-bundle.mjs",
    "host:bundle": "node build/host.cjs",
    "verify:compose": "node scripts/verify-composition.mjs",
    "gen:ui-roster": "node scripts/gen-client-roster.mjs",
    "verify:ui": "node scripts/gen-client-roster.mjs --check",
    "gen:config-catalog": "tsx scripts/gen-config-catalog.ts"
  },
  "devDependencies": {
    "@mediabase/boot": "workspace:^",
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/schemastery": "^3.18.2",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.5.13",
    "esbuild": "^0.25.0",
    "jsdom": "^30.0.1",
    "oxlint": "*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.7",
    "@deepseek-ai/cordis-plugin-loader": "1.0.3",
    "@deepseek-ai/cordis-plugin-include": "1.0.7",
    "js-yaml": "^4.1.0",
    "@types/js-yaml": "^4.0.9"
  },
  "license": "MIT"
}
