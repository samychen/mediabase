{
  "name": "mediabase",
  "version": "0.1.6",
  "private": true,
  "type": "module",
  "scripts": {
    "build:web": "node scripts/gen-client-roster.mjs && pnpm --filter @mediabase/web run build",
    "build:base": "node scripts/build-base.mjs",
    "notice": "node scripts/notice.mjs",
    "check:native": "node scripts/check-native-licenses.mjs",
    "build": "pnpm run build:web",
    "host": "tsx apps/cli/src/index.ts",
    "dev": "pnpm run build:web && tsx apps/cli/src/index.ts",
    "typecheck": "tsc -p tsconfig.host.json && tsc -p tsconfig.client.json && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint .",
    "doctor": "node scripts/doctor.mjs",
    "verify:base": "node scripts/verify.base.mjs",
    "package": "node scripts/package.mjs",
    "build:host": "node scripts/build-host-bundle.mjs",
    "host:bundle": "node build/host.cjs",
    "verify:compose": "node scripts/verify-composition.mjs",
    "gen:ui-roster": "node scripts/gen-client-roster.mjs",
    "verify:ui": "node scripts/gen-client-roster.mjs --check",
    "gen:config-catalog": "tsx scripts/gen-config-catalog.ts",
    "gen:openvideo-roster": "node product/openvideo/scripts/gen-client-roster.mjs",
    "build:openvideo": "node product/openvideo/scripts/gen-client-roster.mjs && pnpm --filter @openvideo/web run build",
    "host:openvideo": "tsx product/openvideo/apps/cli/src/index.ts",
    "dev:openvideo": "pnpm run build:openvideo && pnpm run host:openvideo",
    "typecheck:openvideo": "tsc -p product/openvideo/tsconfig.host.json && tsc -p product/openvideo/tsconfig.client.json && tsc -p product/openvideo/tsconfig.test.json",
    "test:openvideo": "vitest run --config product/openvideo/vitest.config.ts",
    "verify:openvideo:compose": "node scripts/verify-composition.mjs packages/bundle/app/cordis.patch.yml product/openvideo/packages/bundle/app/cordis.patch.yml product/openvideo/packages/bundle/ui/client.yml",
    "verify:openvideo": "node product/openvideo/scripts/verify.mjs",
    "gen:mtxconsole-roster": "node product/mediamtx-console/scripts/gen-client-roster.mjs",
    "build:mtxconsole": "node product/mediamtx-console/scripts/gen-client-roster.mjs && pnpm --filter @mtxconsole/web run build",
    "host:mtxconsole": "tsx product/mediamtx-console/apps/cli/src/index.ts",
    "dev:mtxconsole": "pnpm run build:mtxconsole && pnpm run host:mtxconsole",
    "typecheck:mtxconsole": "tsc -p product/mediamtx-console/tsconfig.host.json && tsc -p product/mediamtx-console/tsconfig.client.json && tsc -p product/mediamtx-console/tsconfig.test.json",
    "test:mtxconsole": "vitest run --config product/mediamtx-console/vitest.config.ts",
    "verify:mtxconsole:compose": "node scripts/verify-composition.mjs packages/bundle/app/cordis.patch.yml product/mediamtx-console/packages/bundle/app/cordis.patch.yml product/mediamtx-console/packages/bundle/ui/client.yml",
    "verify:mtxconsole": "node product/mediamtx-console/scripts/verify.mjs",
    "build:xmedia:engine": "node product/xmedia/scripts/build-engine.mjs",
    "host:xmedia": "node product/xmedia/scripts/sync-whep.mjs && tsx product/xmedia/apps/cli/src/index.ts",
    "sync:whep": "node product/xmedia/scripts/sync-whep.mjs",
    "gen:protocol": "node product/xmedia/scripts/gen-protocol.mjs product/xmedia/protocol/contract.json product/xmedia/engine/src/xmedia_protocol.h",
    "verify:protocol": "node product/xmedia/scripts/verify-protocol.mjs",
    "typecheck:xmedia": "tsc -p product/xmedia/tsconfig.host.json && tsc -p product/xmedia/tsconfig.test.json",
    "test:xmedia": "vitest run --config product/xmedia/vitest.config.ts",
    "verify:xmedia:compose": "node scripts/verify-composition.mjs packages/bundle/app/cordis.patch.yml product/xmedia/packages/bundle/app/cordis.patch.yml",
    "verify:xmedia": "node product/xmedia/scripts/verify.mjs",
    "sync:highlight-engine": "node product/highlight/scripts/sync-engine.mjs",
    "gen:highlight-protocol": "node product/highlight/scripts/gen-protocol.mjs",
    "gen:highlight-roster": "node product/highlight/scripts/gen-client-roster.mjs",
    "check:highlight-drift": "node product/highlight/scripts/sync-engine.mjs --check && node product/highlight/scripts/gen-protocol.mjs --check && node product/highlight/scripts/gen-client-roster.mjs --check",
    "build:highlight": "node product/highlight/scripts/gen-client-roster.mjs && pnpm --filter @vhl/web run build",
    "host:highlight": "tsx product/highlight/apps/cli/src/index.ts",
    "dev:highlight": "pnpm run build:highlight && pnpm run host:highlight",
    "typecheck:highlight": "tsc -p product/highlight/tsconfig.host.json && tsc -p product/highlight/tsconfig.client.json && tsc -p product/highlight/tsconfig.test.json",
    "test:highlight": "vitest run --config product/highlight/vitest.config.ts",
    "verify:highlight:compose": "node scripts/verify-composition.mjs packages/bundle/app/cordis.patch.yml product/highlight/packages/bundle/app/cordis.patch.yml product/highlight/packages/bundle/ui/client.yml",
    "verify:highlight": "node product/highlight/scripts/verify.mjs",
    "verify:highlight:fake": "node product/highlight/scripts/verify.mjs --engine=fake",
    "verify:highlight:real": "node product/highlight/scripts/verify.mjs --engine=real",
    "verify:highlight:all": "pnpm run verify:highlight:fake && pnpm run verify:highlight:real",
    "verify:highlight:ui": "pnpm run build:highlight && node product/highlight/scripts/verify-ui.mjs"
  },
  "devDependencies": {
    "@mediabase/boot": "workspace:^",
    "@mediabase/i18n": "workspace:^",
    "@mediabase/test-host": "workspace:^",
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/schemastery": "^3.18.2",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.5.13",
    "esbuild": "^0.25.0",
    "jsdom": "^30.0.1",
    "oxlint": "*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.7",
    "@deepseek-ai/cordis-plugin-loader": "1.0.3",
    "@deepseek-ai/cordis-plugin-include": "1.0.7",
    "js-yaml": "^4.1.0",
    "@types/js-yaml": "^4.0.9"
  },
  "license": "MIT"
}
