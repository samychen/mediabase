{
  "name": "@mediabase/log",
  "version": "0.1.6",
  "private": true,
  "type": "module",
  "description": "Neutral base: leveled logger with scoped children, provided as ctx.log (stderr by default, injectable sink)",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@mediabase/schema": "workspace:^"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "main": "dist/index.mjs",
