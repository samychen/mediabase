{
  "name": "@mediabase/gateway",
  "version": "0.1.6",
  "private": true,
  "type": "module",
  "description": "Neutral HTTP/WS gateway: SPA static + WS JSON-RPC control plane + raw byte routes (data plane) + notification broadcast — base package",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "dependencies": {
    "@mediabase/rpc": "workspace:^",
    "ws": "^8.18.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "main": "dist/index.mjs",
    "module": "dist/index.mjs",
    "types": "dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.mjs"
      }
    }
  },
  "scripts": {
    "build": "node ../../../scripts/build-base.mjs"
  }
}
