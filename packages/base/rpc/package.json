{
  "name": "@mediabase/rpc",
  "version": "0.1.6",
  "private": true,
  "type": "module",
  "description": "Capability-agnostic JSON-RPC 2.0 (makeServer/makeClient + notifications) — neutral base package for any cordis-style host/client app",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "main": "dist/index.mjs",
    "module": "dist/index.mjs",
    "types": "dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.mjs"
      }
    }
  },
  "scripts": {
    "build": "node ../../../scripts/build-base.mjs"
  }
}
