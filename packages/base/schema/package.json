{
  "name": "@mediabase/schema",
  "version": "0.1.4",
  "private": true,
  "type": "module",
  "description": "Neutral base: mediabase schema dialect — @deepseek-ai/schemastery plus a JSON-Schema bridge for LLM tool parameters",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "main": "dist/index.mjs",
    "module": "dist/index.mjs",
    "types": "dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.mjs"
      }
    }
  },
  "scripts": {
    "build": "node ../../../scripts/build-base.mjs"
  }
}
