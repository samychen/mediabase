{
  "name": "@mediabase/ui-web",
  "version": "0.1.4",
  "private": true,
  "type": "module",
  "description": "Client plugin: capability-agnostic React shell, renders panels registered into ctx.ui",
  "main": "src/index.tsx",
  "types": "src/index.tsx",
  "exports": {
    ".": "./src/index.tsx"
  },
  "dependencies": {
    "@mediabase/i18n": "workspace:^",
    "@mediabase/ui": "workspace:^",
    "@deepseek-ai/cordis": "^4.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@mediabase/schema": "workspace:^"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "main": "dist/index.mjs",
    "module": "dist/index.mjs",
    "types": "dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.mjs"
      }
    }
  },
  "scripts": {
    "build": "node ../../../scripts/build-base.mjs"
  }
}
