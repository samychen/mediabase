{
  "name": "@mediabase/agent",
  "version": "0.1.4",
  "private": true,
  "type": "module",
  "description": "Host plugin: LLM agent loop (OpenAI-compatible function calling) over media/python/workflow tools (ctx.agent)",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "dependencies": {
    "@mediabase/api": "workspace:^",
    "@mediabase/log": "workspace:^",
    "@mediabase/protocol": "workspace:^",
    "@mediabase/rpc": "workspace:^",
    "@mediabase/schema": "workspace:^",
    "@mediabase/settings": "workspace:^",
    "@mediabase/tools": "workspace:^",
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "main": "dist/index.mjs",
    "module": "dist/index.mjs",
    "types": "dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.mjs"
      }
    }
  },
  "scripts": {
    "build": "node ../../../scripts/build-base.mjs"
