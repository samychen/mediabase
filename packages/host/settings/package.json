{
  "name": "@mediabase/settings",
  "version": "0.1.6",
  "private": true,
  "type": "module",
  "description": "Host plugin: persisted key->JSON settings (<appPaths.home>/settings.json) with an in-app UI entry (ctx.settings)",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "dependencies": {
    "@mediabase/api": "^0.1.6",
    "@mediabase/protocol": "^0.1.6",
    "@mediabase/rpc": "^0.1.6",
    "@mediabase/schema": "^0.1.6",
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "main": "dist/index.mjs",
    "module": "dist/index.mjs",
    "types": "dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.mjs"
      }
    }
  },
  "scripts": {
    "build": "node ../../../scripts/build-base.mjs"
  }
}
