# Internal dependencies are declared as SEMVER (not `workspace:^`) on purpose: these
# packages are consumed over git URLs, where `workspace:` cannot resolve and a product
# pins each one to its own commit (see a3e49e6). Inside this repo the same specs must
# resolve to the workspace copies — otherwise pnpm fetches `@mediabase/*` from the
# registry, where the packages do not exist (private, never published), and `pnpm
# install` fails for anyone.
link-workspace-packages=true
