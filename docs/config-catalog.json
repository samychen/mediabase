{
  "note": "generated by scripts/gen-config-catalog.ts — see docs/CONFIG-CATALOG.md",
  "source": "packages/bundle/app/cordis.patch.yml + each capability Config",
  "rows": [
    {
      "id": "log",
      "module": "@mediabase/log",
      "stated": {
        "level": "!!js ctx.env.choice('LOG_LEVEL', ['debug', 'info', 'warn', 'error'])",
        "scope": "!!js ctx.appPaths.bin"
      },
      "schema": {
        "type": "object",
        "properties": {
          "level": {
            "description": "minimum level; default info. A row reads it from the deployment's own vocabulary: level: !!js ctx.env.choice('LOG_LEVEL', ['debug','info','warn','error']) — an unrecognized value falls back here rather than stopping the boot",
            "enum": [
              "debug",
              "info",
              "warn",
              "error"
            ]
          },
          "scope": {
            "description": "scope prefix; default the app name",
            "type": "string"
          },
          "timestamps": {
            "description": "timestamps on the default stderr sink",
            "type": "boolean"
          }
        }
      }
    },
    {
      "id": "api",
      "module": "@mediabase/api",
      "stated": {}
    },
    {
      "id": "settings",
      "module": "@mediabase/settings",
      "stated": {
        "file": "!!js ctx.env.str('SETTINGS_FILE')"
      },
      "schema": {
        "type": "object",
        "properties": {
          "file": {
            "description": "settings JSON path; default ~/.avstudio/settings.json",
            "type": "string"
          }
        }
      }
    },
    {
      "id": "tools",
      "module": "@mediabase/tools",
      "stated": {}
    },
    {
      "id": "agent",
      "module": "@mediabase/agent",
      "stated": {
        "baseUrl": "!!js ctx.env.str('LLM_BASE')",
        "apiKey": "!!js ctx.env.str('LLM_KEY')",
        "model": "!!js ctx.env.str('LLM_MODEL')"
      },
      "schema": {
        "type": "object",
        "properties": {
          "baseUrl": {
            "description": "OpenAI-compatible base URL",
            "default": "https://api.deepseek.com/v1",
            "type": "string"
          },
          "apiKey": {
            "description": "LLM key; empty means \"not configured\"",
            "default": "",
            "type": "string"
          },
          "model": {
            "description": "model name",
            "default": "deepseek-chat",
            "type": "string"
          }
        }
      }
    },
    {
      "id": "plugins",
      "module": "@mediabase/plugins",
      "stated": {
        "root": "!!js ctx.appPaths.root",
        "dataRoot": "!!js ctx.env.str('PLUGIN_DATA_ROOT')",
        "confinementRequired": "!!js ctx.env.flag('SANDBOX_CONFINE_REQUIRED')",
        "envPrefix": "!!js ctx.env.prefix"
      },
      "schema": {
        "type": "object",
        "properties": {
          "root": {
            "description": "application root; default process.cwd()",
            "type": "string"
          },
          "dataRoot": {
            "description": "where per-plugin writable data dirs live",
            "type": "string"
          },
          "confinementRequired": {
            "description": "fail closed for every confined entry that cannot enforce its policy",
            "type": "boolean"
          },
          "envPrefix": {
            "description": "env vocabulary prefix for the sandbox entry / demo catalog lookups (default 'MEDIABASE_')",
            "type": "string"
          }
        }
      }
    },
    {
      "id": "server",
      "module": "@mediabase/server",
      "stated": {
        "root": "!!js ctx.appPaths.root",
        "port": "!!js ctx.env.rawNum('PORT')",
        "distIndex": "!!js ctx.env.str('DIST_INDEX')",
        "token": "!!js ctx.env.str('TOKEN')",
        "crossOriginIsolation": "!!js ctx.env.flag('CROSS_ORIGIN_ISOLATION')",
        "acl": {
          "readonly": "!!js ctx.env.flag('READONLY')",
          "allow": "!!js ctx.env.list('ACL_ALLOW')",
          "deny": "!!js ctx.env.list('ACL_DENY')"
        }
      },
      "schema": {
        "type": "object",
        "properties": {
          "root": {
            "description": "application root (packaged app: its resource root)",
            "type": "string"
          },
          "host": {
            "default": "127.0.0.1",
            "type": "string"
          },
          "port": {
            "description": "listen port; 0 lets the OS pick one",
            "default": 3088,
            "type": "number"
          },
          "distIndex": {
            "description": "absolute path of the client index.html",
            "type": "string"
          },
          "token": {
            "description": "shared secret; empty/absent = no auth (local trust boundary)",
            "type": "string"
          },
          "acl": {
            "description": "method-level access policy",
            "type": "object",
            "properties": {
              "readonly": {
                "description": "refuse every method declared mutates",
                "type": "boolean"
              },
              "allow": {
                "description": "allow list (prefix.* wildcards)",
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "deny": {
                "description": "deny list; wins over allow",
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "crossOriginIsolation": {
            "description": "serve COOP/COEP/CORP for SharedArrayBuffer",
            "type": "boolean"
          }
        },
        "required": [
          "root"
        ]
      }
    }
  ]
}
