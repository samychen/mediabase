# Node
node_modules/
*.tsbuildinfo

# Builds / generated
apps/web/dist/
product/*/apps/web/dist/
# xmedia ships a dependency-free static shell as SOURCE, not a Vite build output.
!product/xmedia/apps/web/dist/
!product/xmedia/apps/web/dist/index.html
product/xmedia/engine/build/
# clangd's index cache lands next to the sources when it opens them.
product/xmedia/engine/.cache/

# Logs / runtime
*.log
# runtime state a running host creates (confined plugins get a data dir here)
.mediabase/
.openvideo/
.mtxconsole/
.xmedia/
.vscode/
.workbuddy/
.DS_Store

# scratch dirs created by tests
tests/.tmp-plugins/

# source distribution
release/

# host bundle + the closed runtime it ships (build/plugins.json, build/plugins/, …)
build/

# base package build output (@mediabase/*) and packed tarballs
packages/**/dist/
packages/**/LICENSE
*.tgz

# electron local cache (packaging)
**/.electron-cache/

# the ffmpeg copy prepare-ffmpeg.mjs stages for the packaged app
packaging/desktop-electron/vendor-ffmpeg/
